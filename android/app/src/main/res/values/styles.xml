<?xml version="1.0" encoding="utf-8"?>
<!-- BBS CLUB - SPLASH PREMIUM: quita el azul 0F172A y el morado, deja todo negro/dorado -->
<resources>
    <!-- Splash API 31+ (Android 12) - esto es lo que se ve en tu foto 1 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <!-- Android 12 SplashScreen API -->
        <item name="android:windowSplashScreenBackground">#0A0A0A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">1800</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
